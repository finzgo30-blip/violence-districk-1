			local ok = pcall(function()
				local p, z = btn.AbsolutePosition, btn.AbsoluteSize
				local inset = GuiService:GetGuiInset()
				local x, y = p.X + z.X * 0.5 + inset.X, p.Y + z.Y * 0.5 + inset.Y
				local id = 8822
				VirtualInputManager:SendTouchEvent(id, 0, x, y)
				task.wait(0.025)
				VirtualInputManager:SendTouchEvent(id, 2, x, y)
			end)
			if ok then return true end
		end

		local ok = pcall(function()
			VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
			task.wait(0.025)
			VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
		end)
		return ok
	end

	function Class:_inAngleRange(lineRot, goalRot, minOff, maxOff)
		local minA = (goalRot + minOff) % 360
		local maxA = (goalRot + maxOff) % 360
		if maxA < minA then
			return minA <= lineRot or lineRot <= maxA
		end
		return minA <= lineRot and lineRot <= maxA
	end

	function Class:_shouldFireByRange(lineRot, goalRot)
		local S = self.Settings
		local m = S.Mode
		if m == "Normal" then
			return self:_inAngleRange(lineRot, goalRot, S.NormalMinOffset, S.NormalMaxOffset)
		end
		return self:_inAngleRange(lineRot, goalRot, S.LegitMinOffset, S.LegitMaxOffset)
	end

	function Class:_onHeartbeat()
		if not self.Settings.Enabled or self._busy then return end

		local scGui
		for _, guiName in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
			local candidate = PlayerGui:FindFirstChild(guiName)
			if candidate and candidate.Enabled ~= false then
				local c = candidate:FindFirstChild("Check")
				if c and c.Visible then scGui = candidate; break end
			end
		end
		if not scGui then return end

		local check = scGui:FindFirstChild("Check")
		if not check or not check.Visible then return end
		local line = check:FindFirstChild("Line")
		if not line then return end

		local mode = self.Settings.Mode
		local goal = check:FindFirstChild("Goal")
		local trap = check:FindFirstChild("TrapPerfect") or check:FindFirstChild("TrapGoal")

		if mode == "Instant" then
			local target = trap and trap.Visible and trap or (goal and goal.Visible and goal)
			if not target then return end
			self._busy = true
			task.spawn(function()
				local fired = false
				local ok = pcall(function()
					-- Move the local indicator into the hit window, then send one real input.
					line.Rotation = (target.Rotation + self.Settings.InstantOffset) % 360
					RunService.Heartbeat:Wait()
					fired = self:_fireAction()
				end)
				if fired and ok then
					self.Stats.Hits = self.Stats.Hits + 1
				else
					self.Stats.Missed = self.Stats.Missed + 1
				end
				task.wait(math.max(0.12, self.Settings.BusyResetDelay))
				self._busy = false
			end)
			return
		end

		if not goal then return end
		if (check:FindFirstChild("TrapPerfect") and check.TrapPerfect.Visible)
			or (check:FindFirstChild("TrapGoal") and check.TrapGoal.Visible) then return end
		if not self:_shouldFireByRange(line.Rotation % 360, goal.Rotation % 360) then return end

		self._busy = true
		task.spawn(function()
			local ok = self:_fireAction()
			if ok then
				self.Stats.Hits = self.Stats.Hits + 1
			else
				self.Stats.Missed = self.Stats.Missed + 1
			end
			task.wait(self.Settings.BusyResetDelay)
			self._busy = false
		end)
	end

	function Class:_hookKingScourge()
		task.spawn(function()
			pcall(function()
				local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
				if not remotes then return end
				local perks = remotes:WaitForChild("KillerPerks", 5)
				if not perks then return end
				local ks = perks:WaitForChild("kingscourge", 5)
				if not ks then return end
				local start = ks:WaitForChild("KingScourgeStart", 5)
				if not start then return end

				if self._kingConn then self._kingConn:Disconnect() end
				self._kingConn = start.OnClientEvent:Connect(function() end)
			end)
		end)
	end

	function Class:Start()
		self.Settings.Enabled = true
		if self._heartbeat then return end
		self:_hookKingScourge()
		self._heartbeat = RunService.Heartbeat:Connect(function()
			if unloaded then return end
			pcall(function() self:_onHeartbeat() end)
		end)
	end

	function Class:Stop()
		self.Settings.Enabled = false
		if self._heartbeat then
			self._heartbeat:Disconnect()
			self._heartbeat = nil
		end
		if self._kingConn then
			self._kingConn:Disconnect()
			self._kingConn = nil
		end
		self._busy = false
		self._randomModeIsNormal = false
	end

	function Class:SetMode(mode)
		local valid = { Legit = true, Normal = true }
		if not valid[mode] then return false end
		self.Settings.Mode = mode
		self._randomModeIsNormal = false
		return true
	end

	return Class.new()
end)()

