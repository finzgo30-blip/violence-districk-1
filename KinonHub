		local function refreshSwatch() swatch.BackgroundColor3 = get() end
		swatch.MouseButton1Click:Connect(function()
			if popBtn == swatch then closePopup() return end
			showPalette(swatch, get, set, refreshSwatch)
			popBtn = swatch
		end)
		reg(card, label, toHex(get()), function() return toHex(get()) end, function(v)
			local c = fromHex(v)
			if c then set(c); refreshSwatch() end
		end)
		return swatch
	end

