		local h = 8 + SVH + 8 + HUEH + 8 + HEXH + 8
		local hue, sat, val = get():ToHSV()

		local popup = new("Frame", {
			Name = "KinonPicker",
			BackgroundColor3 = TH.Panel2,
			BorderSizePixel = 0,
			Active = true,
			ZIndex = 50,
		}, gui)
		new("UIScale", { Scale = scale }, popup)
		corner(popup, 8)
		new("UIStroke", { Color = TH.Stroke, Transparency = 0.15, Thickness = 1 }, popup)

		local sv = new("TextButton", {
			Position = UDim2.fromOffset(8, 8),
			Size = UDim2.fromOffset(W, SVH),
			BackgroundColor3 = Color3.fromHSV(hue, 1, 1),
			Text = "",
			AutoButtonColor = false,
			ZIndex = 52,
		}, popup)
		corner(sv, 6)
		local white = new("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0, ZIndex = 53, Active = false,
		}, sv)
		corner(white, 6)
		new("UIGradient", {
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
		}, white)
		local black = new("Frame", {
			Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 0, ZIndex = 54, Active = false,
		}, sv)
		corner(black, 6)
		new("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
		}, black)
		local cursor = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(12, 12),
			BackgroundTransparency = 1,
			ZIndex = 56,
		}, sv)
		corner(cursor, 6)
		new("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 2 }, cursor)

		local bar = new("TextButton", {
			Position = UDim2.fromOffset(8, 8 + SVH + 8),
			Size = UDim2.fromOffset(W, HUEH),
			BackgroundColor3 = Color3.new(1, 1, 1),
			Text = "",
			AutoButtonColor = false,
			ZIndex = 52,
		}, popup)
		corner(bar, 6)
		local seq = {}
		for i = 0, 6 do seq[#seq + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(math.min(i / 6, 0.9999), 1, 1)) end
		new("UIGradient", { Color = ColorSequence.new(seq) }, bar)
		local hmark = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.fromOffset(6, HUEH + 6),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			ZIndex = 56,
		}, bar)
		corner(hmark, 3)
		new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.4 }, hmark)

		local hexBox = new("TextBox", {
			Position = UDim2.fromOffset(8, 8 + SVH + 8 + HUEH + 8),
			Size = UDim2.fromOffset(W, HEXH),
			BackgroundColor3 = TH.Panel3,
			ClearTextOnFocus = false,
			Font = Enum.Font.GothamBold,
			TextSize = 13,
			TextColor3 = TH.Text,
			Text = "",
			ZIndex = 52,
		}, popup)
		corner(hexBox, 6)

		local function paint(fromHex)
			local c = Color3.fromHSV(hue, sat, val)
			sv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
			cursor.Position = UDim2.fromScale(sat, 1 - val)
			hmark.Position = UDim2.fromScale(hue, 0.5)
			if not fromHex then hexBox.Text = toHex(c) end
			return c
		end
		local function apply(fromHex)
			local c = paint(fromHex)
			set(c)
			if refreshSwatch then refreshSwatch() end
		end
		paint(false)

		local mode
		local function drag(pos)
			if mode == "sv" then
				sat = math.clamp((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
				val = 1 - math.clamp((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
				apply(false)
			elseif mode == "hue" then
				hue = math.clamp((pos.X - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 0.9999)
				apply(false)
			end
		end
		local function isPress(i)
			return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
		end
		sv.InputBegan:Connect(function(i) if isPress(i) then mode = "sv"; drag(i.Position) end end)
		bar.InputBegan:Connect(function(i) if isPress(i) then mode = "hue"; drag(i.Position) end end)
		hexBox.FocusLost:Connect(function()
			local c = fromHex(hexBox.Text)
			if c then
				hue, sat, val = c:ToHSV()
				apply(true)
				hexBox.Text = toHex(c)
			else
				hexBox.Text = toHex(Color3.fromHSV(hue, sat, val))
			end
		end)
		local extra = {}
		extra[#extra + 1] = UserInputService.InputChanged:Connect(function(i)
			if mode and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
				drag(i.Position)
			end
		end)
		extra[#extra + 1] = UserInputService.InputEnded:Connect(function(i)
			if isPress(i) then mode = nil end
		end)

		finishPopup(btn, popup, gui, mainFrame, scale, h, w)
		local base = popClose
		popClose = function()
			for _, c in ipairs(extra) do pcall(function() c:Disconnect() end) end
			if base then base() end
		end
	end

