	local exp = math.exp
	function M.Regress(list, tn, window, tau)
		if not list then return nil end
		local sw, sdt, sdt2, n = 0, 0, 0, 0
		local sp, sdtp = Vector3.zero, Vector3.zero
		for i = #list, 1, -1 do
