    function card:slider(label, minValue, maxValue, default, onChange)
        local order = addRow(SLIDER_H)
        local holderFrame = make("Frame", {
            LayoutOrder = order,
            Size = UDim2.new(1, 0, 0, SLIDER_H),
            BackgroundTransparency = 1,
        }, frame)
        make("TextLabel", {
