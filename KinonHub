local function notify(t, m, d)
    pcall(function()
        StarterGui_:SetCore("SendNotification", {
            Title = t, Text = m, Duration = d or 5
        })
    end)
end

local function extractId(v)
    if type(v) ~= "string" then return nil end
    return v:match("(%d+)")
end

local function waitLoaded(imgLabel, content)
    local ok = pcall(function() imgLabel.Image = content end)
    if not ok then return false end
    local t0 = os.clock()
    while not imgLabel.IsLoaded and os.clock() - t0 < 3 do
        task.wait(0.1)
    end
    return imgLabel.IsLoaded
end

local function textureFromObject(id)
    local ok, objs = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if not ok or type(objs) ~= "table" then return nil end
    local o = objs[1]
    if not o then return nil end
    local tex
    pcall(function()
        if o:IsA("Decal") or o:IsA("Texture") then
            tex = o.Texture
        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
            tex = o.Image
        else
            local d = o:FindFirstChildWhichIsA("Decal", true) or o:FindFirstChildWhichIsA("Texture", true)
            if d then tex = d.Texture end
        end
    end)
    pcall(function() o:Destroy() end)
    if type(tex) == "string" and tex ~= "" then return tex end
    return nil
end

local function applyLogo(imgLabel, assets, fallbackText)
    if type(assets) ~= "table" or #assets == 0 then return end
    imgLabel.ImageTransparency = 0
    imgLabel.ImageColor3 = WHITE
    task.spawn(function()
        for _, raw in ipairs(assets) do
            local id = extractId(raw)
            if id then
                local tries = {
                    "rbxassetid://" .. id,
                    "rbxthumb://type=Asset&id=" .. id .. "&w=150&h=150",
                }
                for _, content in ipairs(tries) do
                    if waitLoaded(imgLabel, content) then
                        print("[Kinon] Logo loaded:", content)
                        return
                    end
                end
                local tex = textureFromObject(id)
                if tex and waitLoaded(imgLabel, tex) then
                    print("[Kinon] Logo loaded:", tex)
                    return
                end
            end
        end
        print("[Kinon] All logos failed, using text fallback")
        imgLabel.Image = ""
        if fallbackText then fallbackText.Visible = true end
    end)
end

local function getParent()
    local result
    pcall(function() if gethui then result = gethui() end end)
    if result then return result end
    pcall(function() result = game:GetService("CoreGui") end)
    if result then return result end
    local pg = Lp:FindFirstChildOfClass("PlayerGui")
    if not pg then pg = Lp:WaitForChild("PlayerGui", 5) end
    return pg
end

