State.SkillCheckTrap = { On = false, Mode = "Instant" }
do
	local T = State.SkillCheckTrap
	local conn
	local busy = false
	local function inRange(lineRot, goalRot)
		local a = (goalRot + 102) % 360
		local b = (goalRot + 116) % 360
		if a > b then return lineRot >= a or lineRot <= b end
		return lineRot >= a and lineRot <= b
	end
	local function step()
		if unloaded or not T.On or busy then return end
		local pg = LP:FindFirstChildOfClass("PlayerGui")
		if not pg then return end
		for _, name in ipairs({ "SkillCheckPromptGui", "SkillCheckPromptGui-con" }) do
			local prompt = pg:FindFirstChild(name)
			if prompt and prompt.Enabled ~= false then
				local check = prompt:FindFirstChild("Check")
				if check and check.Visible then
					local line = check:FindFirstChild("Line")
					if not line then return end
					local target
					for _, tn in ipairs({ "TrapPerfect", "TrapGoal" }) do
						local c = check:FindFirstChild(tn)
						if c and c.Visible then target = c; break end
					end
					if not target then return end

					local instant = T.Mode == "Instant"
					local shouldPress = false
					if instant then
						-- Align the local marker with the trap's hit window before sending input.
						line.Rotation = (target.Rotation + 109) % 360
						shouldPress = true
					else
						shouldPress = inRange(line.Rotation % 360, target.Rotation % 360)
					end

					if shouldPress then
						busy = true
						task.spawn(function()
							local fired = false
						pcall(function()
								if instant then RunService.Heartbeat:Wait() end
								fired = State.SkillCheckObj:_fireAction()
							end)
						-- Longer lockout for instant mode prevents duplicate taps while the prompt closes.
						task.wait(instant and 0.4 or 0.05)
						busy = false
					end)
					end
					return
				end
			end
		end
	end
	State.TrapSkillSet = function(v)
		T.On = v == true
		if conn then conn:Disconnect(); conn = nil end
		busy = false
		if T.On then conn = RunService.RenderStepped:Connect(function() pcall(step) end) end
	end
end

