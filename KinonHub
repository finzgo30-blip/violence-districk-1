local LOGO_ASSETS = {
    "rbxassetid://10140231007",
}
local logoCache
local function resolveLogo()
    if logoCache ~= nil then return logoCache or nil end
    local ContentProvider = game:GetService("ContentProvider")
    local tmpGui = Instance.new("ScreenGui")
    tmpGui.Name = "KinonLogoProbe"
    pcall(function() tmpGui.Parent = UIParent end)
    local function loads(src)
        local probe = Instance.new("ImageLabel")
        probe.Size = UDim2.fromOffset(4, 4)
        probe.BackgroundTransparency = 1
        probe.Image = src
        probe.Parent = tmpGui
        pcall(function() ContentProvider:PreloadAsync({ probe }) end)
        local ok = probe.IsLoaded
        probe:Destroy()
        return ok
    end
    local function textureOf(id)
        local okObj, objs = pcall(function() return game:GetObjects("rbxassetid://" .. id) end)
        if not okObj or type(objs) ~= "table" then return nil end
        for _, o in ipairs(objs) do
            local tex
            if o:IsA("Decal") or o:IsA("Texture") then
                tex = o.Texture
            elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
                tex = o.Image
            else
                local inner = o:FindFirstChildWhichIsA("Decal", true) or o:FindFirstChildWhichIsA("Texture", true)
                tex = inner and inner.Texture
            end
            if tex and tex ~= "" then return tex end
        end
        return nil
    end
    local function fileOf(id)
        if type(writefile) ~= "function" or type(getcustomasset) ~= "function" then return nil end
        local function fetch(x)
            local okGet, data = pcall(function()
                return game:HttpGet("https://assetdelivery.roblox.com/v1/asset/?id=" .. x)
            end)
            return okGet and type(data) == "string" and data or nil
        end
        local data = fetch(id)
        if not data then return nil end
        if data:sub(2, 4) ~= "PNG" then
            local imgId = data:match("[?&]id=(%d+)") or data:match("asset/%?id=(%d+)")
            if not imgId then return nil end
            data = fetch(imgId)
            if not data or data:sub(2, 4) ~= "PNG" then return nil end
        end
        local name = "KinonHubBeta_logo_" .. id .. ".png"
        local okW = pcall(writefile, name, data)
        if not okW then return nil end
        local okC, asset = pcall(getcustomasset, name)
        return okC and asset or nil
    end

    local blind
    for _, asset in ipairs(LOGO_ASSETS) do
        local id = tostring(asset):match("%d+")
        if id then
            local steps = {
                function() return "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420" end,
                function() return textureOf(id) end,
                function() return fileOf(id) end,
                function() return "rbxassetid://" .. id end,
                function() return "http://www.roblox.com/asset/?id=" .. id end,
                function() return "rbxthumb://type=Asset&id=" .. (tonumber(id) - 1) .. "&w=420&h=420" end,
                function() return "rbxassetid://" .. (tonumber(id) - 1) end,
            }
            for index, step in ipairs(steps) do
                local okStep, src = pcall(step)
                if okStep and type(src) == "string" and src ~= "" then
                    if index <= 3 then blind = blind or src end
                    if loads(src) then
                        tmpGui:Destroy()
                        logoCache = src
                        return src
                    end
                end
            end
        end
    end
    tmpGui:Destroy()
    logoCache = blind or false
    return blind
end
