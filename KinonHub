local function getEndTimeStrings()
    local h24 = MAINT_END_HOUR_24 % 24
    local h12, period
    if h24 == 0 then h12, period = 12, "AM"
    elseif h24 < 12 then h12, period = h24, "AM"
    elseif h24 == 12 then h12, period = 12, "PM"
    else h12, period = h24 - 12, "PM" end

    local idPeriod
    if period == "AM" then
        idPeriod = (h12 == 12) and "malam" or "pagi"
    else
        if h12 == 12 or h12 <= 3 then idPeriod = "siang"
        elseif h12 <= 6 then idPeriod = "sore"
        else idPeriod = "malam" end
    end

    return {
        EN = string.format("tomorrow at %d %s", h12, period),
        ID = string.format("besok jam %d %s", h12, idPeriod),
    }
end

