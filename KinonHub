local runAutoload
do
    local configDir = "KinonHub/configs"
    local exportDir = "KinonHub/export"
    local autoloadFile = "KinonHub/autoload.txt"
    local hasFs = type(writefile) == "function" and type(readfile) == "function"
        and type(isfile) == "function" and type(isfolder) == "function"
        and type(makefolder) == "function" and type(listfiles) == "function"
    local hasClipboard = type(setclipboard) == "function"
    local memoryStore = _G.KinonHubConfigStore or {}
    _G.KinonHubConfigStore = memoryStore

    if hasFs then
        pcall(function()
            for _, folder in ipairs({ "KinonHub", configDir, exportDir }) do
                if not isfolder(folder) then makefolder(folder) end
            end
        end)
    end

    local CODE_PREFIX = "KINON1"
    local MAX_CODE_LENGTH = 12000

    local getName, setName, configList, getCode, setCode, getPaste, getFile
    local setAutoInfo, statusProfile, statusTools

    local function good(setter, text)
        if setter then setter(text, Theme.Success) end
    end
    local function bad(setter, text)
        if setter then setter("! " .. text, Theme.Warning) end
    end

    local function trim(text)
        return (tostring(text or ""):match("^%s*(.-)%s*$"))
    end

    local function cleanName(text)
        local name = tostring(text or "")
        name = name:gsub("[^%w_%- ]", "")
        name = name:gsub("^%s+", "")
        name = name:gsub("%s+$", "")
        if name == "" then name = "default" end
        return string.sub(name, 1, 24)
    end

    local function configPath(name)
        return configDir .. "/" .. name .. ".json"
    end

    ----------------------------------------------------------------------------
    -- Storage
    ----------------------------------------------------------------------------

    local function buildPayload(values)
        return HttpService:JSONEncode({
            version = 1,
            time = os.date("%d/%m %H:%M"),
            values = values,
        })
    end

    local function collectValues()
        local values = {}
        for _, control in ipairs(controls) do
            values[control.Key] = control.Get()
        end
        return values
    end

    local function applyValues(values)
        local count = 0
        for _, control in ipairs(controls) do
            local value = values[control.Key]
            if value ~= nil and type(value) == type(control.Get()) then
                if pcall(control.Set, value) then count += 1 end
            end
        end
        return count
    end

    local function readRaw(name)
        if hasFs then
            local path = configPath(name)
            local ok, exists = pcall(isfile, path)
            if ok and exists then
                local okRead, content = pcall(readfile, path)
                if okRead then return content end
            end
            return nil
        end
        return memoryStore[name]
    end

    local function writeRaw(name, raw)
        if hasFs then
            local ok, err = pcall(writefile, configPath(name), raw)
            if not ok then return false, tostring(err) end
            return true
        end
        memoryStore[name] = raw
        return true
    end

    local function removeRaw(name)
        if hasFs then
            if type(delfile) ~= "function" then return false end
            return (pcall(delfile, configPath(name)))
        end
        memoryStore[name] = nil
        return true
    end

    local function readData(name)
        local raw = readRaw(name)
        if not raw then return nil end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(data) == "table" and type(data.values) == "table" then
            return data
        end
        return nil
    end

    local function listConfigs()
        local names = {}
        if hasFs then
            local ok, files = pcall(listfiles, configDir)
            if ok and type(files) == "table" then
                for _, path in ipairs(files) do
                    local name = tostring(path):match("([^/\\]+)%.json$")
                    if name then table.insert(names, name) end
                end
            end
        else
            for name in pairs(memoryStore) do
                if string.sub(name, 1, 2) ~= "__" then table.insert(names, name) end
            end
        end
        table.sort(names)
        return names
    end

    local function readAutoload()
        local name
        if hasFs then
            local ok, exists = pcall(isfile, autoloadFile)
            if ok and exists then
                local okRead, content = pcall(readfile, autoloadFile)
                if okRead then name = content end
            end
        else
            name = memoryStore.__autoload
        end
        if type(name) ~= "string" or trim(name) == "" then return nil end
        return cleanName(name)
    end

    local function writeAutoload(name)
        if hasFs then
            if name then
                pcall(writefile, autoloadFile, name)
            elseif type(delfile) == "function" then
                pcall(delfile, autoloadFile)
            else
                pcall(writefile, autoloadFile, "")
            end
        else
            memoryStore.__autoload = name
        end
    end

    ----------------------------------------------------------------------------
    -- Share codes: KINON1.<base64 of changed settings>.<checksum>
    -- Only settings that differ from their default are stored, which keeps the
    -- code short. Interface options (scale, lock, ...) are never shared.
    ----------------------------------------------------------------------------

    local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    local B64Index = {}
    for index = 1, #B64 do
        B64Index[string.sub(B64, index, index)] = index - 1
    end

    local function b64encode(data)
        local out = {}
        for i = 1, #data, 3 do
            local a, b, c = string.byte(data, i, i + 2)
            local n = a * 65536 + (b or 0) * 256 + (c or 0)
            local i1, i2, i3, i4 = n // 262144 % 64, n // 4096 % 64, n // 64 % 64, n % 64
            out[#out + 1] = string.sub(B64, i1 + 1, i1 + 1) .. string.sub(B64, i2 + 1, i2 + 1)
            if b then out[#out + 1] = string.sub(B64, i3 + 1, i3 + 1) end
            if c then out[#out + 1] = string.sub(B64, i4 + 1, i4 + 1) end
        end
        return table.concat(out)
    end

    local function b64decode(text)
        if #text % 4 == 1 then return nil end
        local out = {}
        for i = 1, #text, 4 do
            local chunk = string.sub(text, i, i + 3)
            local values = {}
            for k = 1, #chunk do
                local v = B64Index[string.sub(chunk, k, k)]
                if v == nil then return nil end
                values[k] = v
            end
            local n = values[1] * 262144 + values[2] * 4096 + (values[3] or 0) * 64 + (values[4] or 0)
            out[#out + 1] = string.char(n // 65536 % 256)
            if #chunk >= 3 then out[#out + 1] = string.char(n // 256 % 256) end
            if #chunk == 4 then out[#out + 1] = string.char(n % 256) end
        end
        return table.concat(out)
    end

    local function checksum(text)
        local sum = 7
        for i = 1, #text do
            sum = (sum * 31 + string.byte(text, i)) % 65521
        end
        return string.format("%04x", sum)
    end

    local function isShared(control)
        return string.sub(control.Key, 1, 10) ~= "INTERFACE/"
    end

    local function createShareCode()
        local changed, count = {}, 0
        for _, control in ipairs(controls) do
            if isShared(control) then
                local value = control.Get()
                if value ~= control.Default then
                    changed[control.Key] = value
                    count += 1
                end
            end
        end
        local payload = b64encode(HttpService:JSONEncode({ v = 1, d = changed }))
        return CODE_PREFIX .. "." .. payload .. "." .. checksum(payload), count
    end

    local function readShareCode(text)
        text = tostring(text or ""):gsub("%s+", "")
        if text == "" then return nil, "Paste a share code first" end
        if #text > MAX_CODE_LENGTH then return nil, "That code is too long" end
        local prefix, payload, check = text:match("^(%w+)%.([%w_%-]+)%.(%x%x%x%x)$")
        if prefix ~= CODE_PREFIX then return nil, "That is not a Kinon share code" end
        if checksum(payload) ~= string.lower(check) then
            return nil, "The code is damaged, copy it again"
        end
        local json = b64decode(payload)
        if not json then return nil, "The code could not be read" end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
        if not ok or type(data) ~= "table" or data.v ~= 1 or type(data.d) ~= "table" then
            return nil, "The code could not be read"
        end
        return data.d
    end

    -- Resets every shared setting to default, then applies the code on top.
    local function applyShareCode(changed)
        local count = 0
        for _, control in ipairs(controls) do
            if isShared(control) then
                local value = changed[control.Key]
                if value ~= nil and type(value) == type(control.Default) then
                    count += 1
                else
                    value = control.Default
                end
                pcall(control.Set, value)
            end
        end
        return count
    end

    ----------------------------------------------------------------------------
    -- Actions
    ----------------------------------------------------------------------------

    local function savedLine(name)
        local data = readData(name)
        if data then
            return string.format("'%s' | Saved %s", name, tostring(data.time or "--")), Theme.Muted
        end
        return string.format("'%s' | Not saved yet", name), Theme.Muted
    end

    -- Returns the typed name, or nil (and a message) when the box is empty.
    local function currentName(setter)
        local typed = trim(getName())
        if typed == "" then
            bad(setter, "Type a config name first")
            return nil
        end
        local name = cleanName(typed)
        setName(name)
        return name
    end

    local function refreshList()
        configList.setItems(listConfigs())
        local typed = trim(getName())
        if typed ~= "" then configList.select(cleanName(typed)) end
        if setAutoInfo then setAutoInfo(readAutoload() or "off") end
    end

    local function doSave()
        local name = currentName(statusProfile)
        if not name then return end
        local ok, err = writeRaw(name, buildPayload(collectValues()))
        if ok then
            good(statusProfile, string.format("Saved '%s' at %s", name, os.date("%H:%M")))
        else
            bad(statusProfile, "Save failed: " .. tostring(err))
        end
        refreshList()
    end

    local function doLoad()
        local name = currentName(statusProfile)
        if not name then return end
        local data = readData(name)
        if not data then
            bad(statusProfile, string.format("Config '%s' was not found", name))
            return
        end
        configList.select(name)
        good(statusProfile, string.format("Loaded '%s' (%d settings)", name, applyValues(data.values)))
    end

    local function doDelete()
        local name = currentName(statusProfile)
        if not name then return end
        if not readRaw(name) then
            bad(statusProfile, string.format("Config '%s' was not found", name))
            return
        end
        if removeRaw(name) then
            if readAutoload() == name then writeAutoload(nil) end
            good(statusProfile, string.format("Deleted '%s'", name))
        else
            bad(statusProfile, "This executor cannot delete files")
        end
        refreshList()
    end

    local function doCreateCode()
        local code, count = createShareCode()
        setCode(code)
        local copied = hasClipboard and pcall(setclipboard, code)
        local summary = count == 1 and "1 changed setting" or (count .. " changed settings")
        if copied then
            good(statusProfile, "Code created (" .. summary .. ") and copied")
        else
            good(statusProfile, "Code created (" .. summary .. "). Copy it from the box")
        end
    end

    local function doLoadCode()
        local text = trim(getPaste())
        if text == "" and type(getclipboard) == "function" then
            local okClip, clip = pcall(getclipboard)
            if okClip and type(clip) == "string" then text = trim(clip) end
        end
        local changed, err = readShareCode(text)
        if not changed then
            bad(statusTools, err)
            return
        end
        local count = applyShareCode(changed)
        good(statusTools, string.format("Code loaded (%d settings). Save it in a slot to keep it", count))
    end

    local function doImport()
        local path = trim(getFile())
        if path == "" then
            bad(statusTools, "Type the file name to import first")
            return
        end
        if not hasFs then
            bad(statusTools, "This executor has no file access")
            return
        end
        local raw
        for _, candidate in ipairs({ path, path .. ".json", exportDir .. "/" .. path, exportDir .. "/" .. path .. ".json" }) do
            local ok, exists = pcall(isfile, candidate)
            if ok and exists then
                local okRead, content = pcall(readfile, candidate)
                if okRead then
                    raw = content
                    break
                end
            end
        end
        if not raw then
            bad(statusTools, string.format("File '%s' was not found", path))
            return
        end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if not ok or type(data) ~= "table" or type(data.values) ~= "table" then
            bad(statusTools, "That file is not a valid Kinon config")
            return
        end
        local base = (path:match("([^/\\]+)$") or path):gsub("%.json$", "")
        local typed = trim(getName())
        local name = typed ~= "" and cleanName(typed) or cleanName(base)
        local saved, err = writeRaw(name, buildPayload(data.values))
        if not saved then
            bad(statusTools, "Import failed: " .. tostring(err))
            return
        end
        setName(name)
        refreshList()
        good(statusTools, string.format("Imported as '%s'. Press Load to use it", name))
    end

    local function doExport()
        local name = currentName(statusTools)
        if not name then return end
        local raw = readRaw(name)
        if not raw then
            bad(statusTools, string.format("Save '%s' first, then export it", name))
            return
        end
        local copied = hasClipboard and pcall(setclipboard, raw)
        if not hasFs then
            if copied then
                good(statusTools, "No file access: config copied to the clipboard")
            else
                bad(statusTools, "This executor has no file access or clipboard")
            end
            return
        end
        local file = trim(getFile())
        if file == "" then file = exportDir .. "/" .. name .. ".json" end
        if not string.lower(file):match("%.json$") then file = file .. ".json" end
        local ok, err = pcall(writefile, file, raw)
        if ok then
            good(statusTools, "Exported to " .. file)
        else
            bad(statusTools, "Export failed: " .. tostring(err))
        end
    end

    local function doSetAutoload()
        local name = currentName(statusTools)
        if not name then return end
        if not readRaw(name) then
            bad(statusTools, string.format("Save '%s' first, then set it as Auto-Load", name))
            return
        end
        writeAutoload(name)
        refreshList()
        good(statusTools, string.format("Auto-Load is now '%s'", name))
    end

    local function doClearAutoload()
        writeAutoload(nil)
        refreshList()
        good(statusTools, "Auto-Load is off")
    end

    local function doReset()
        local count = 0
        for _, control in ipairs(controls) do
            if pcall(control.Set, control.Default) then count += 1 end
        end
        good(statusTools, string.format("Reset %d settings to default", count))
    end

    ----------------------------------------------------------------------------
    -- CONFIG card
    ----------------------------------------------------------------------------

    local configCard = createCard("CONFIG", "save", "UI")
    getName, setName = configCard:textbox("Type a config name", "")
    configList = configCard:list(88, function(name)
        setName(name)
        statusProfile(savedLine(name))
    end)
    statusProfile = configCard:note("Only saved configs are listed", 24)
    configCard:buttons({ { "Save", doSave }, { "Load", doLoad }, { "Delete", doDelete } })
    configCard:section("SHARE")
    configCard:button("Create Code", doCreateCode)
    getCode, setCode = configCard:textbox("Your share code appears here", "")

    local toolsCard = createCard("CONFIG TOOLS", "folder", "UI")
    toolsCard:section("LOAD CODE")
    getPaste = toolsCard:textbox("Paste a share code here", "")
    toolsCard:button("Load Code", doLoadCode)
    toolsCard:section("FILES")
    getFile = toolsCard:textbox("File name, e.g. mycfg.json", "")
    toolsCard:buttons({ { "Import File", doImport }, { "Export File", doExport } })
    toolsCard:note("Import saves into the name typed in CONFIG. Export and Auto-Load use it too.", 24)
    toolsCard:section("AUTO-LOAD")
    setAutoInfo = toolsCard:info("Auto-Load", "off")
    toolsCard:buttons({ { "Set Auto-Load", doSetAutoload }, { "Auto-Load Off", doClearAutoload } })
    toolsCard:section("RESET")
    toolsCard:button("Reset to Default", doReset)
    statusTools = toolsCard:note("Ready", 24)
    refreshList()

    runAutoload = function()
        local name = readAutoload()
        if not name then return end
        local data = readData(name)
        if data then
            setName(name)
            configList.select(name)
            good(statusProfile, string.format("Auto loaded '%s' (%d settings)", name, applyValues(data.values)))
        end
    end
end

