			for _, it in ipairs(items) do
				if get(it.id) == true then
					n = n + 1
					first = first or tostring(it.name or it.id)
				end
			end
			cur.Text = n == 0 and "None" or (n == 1 and first or (n .. " selected"))
		end
		render()
		btn.MouseButton1Click:Connect(function()
			if popBtn == btn then closePopup() return end
			showPopup(btn, items, function(it) return it.name or it.id end,
				function(it) return get(it.id) == true end,
				function(it) set(it.id, not (get(it.id) == true)); render() end, true, label)
		end)
		for _, it in ipairs(items) do
			reg(card, label .. "/" .. tostring(it.name or it.id), get(it.id) == true,
