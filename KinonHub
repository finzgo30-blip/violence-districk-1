            TextXAlignment = Enum.TextXAlignment.Left,
        }, holderFrame)

        local valueLabel = make("TextLabel", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 0, 0, 0),
            Size = UDim2.fromOffset(48, 14),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            Text = tostring(default),
            TextColor3 = Theme.Text,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Right,
        }, holderFrame)

        local hit = make("TextButton", {
            Position = UDim2.fromOffset(0, 17),
            Size = UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
        }, holderFrame)
        local bar = make("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(1, 0, 0, 6),
            BackgroundColor3 = Theme.Panel3,
            BorderSizePixel = 0,
        }, hit)
        corner(bar, 4)

        local alpha = math.clamp((default - minValue) / (maxValue - minValue), 0, 1)
        local fill = make("Frame", {
            Size = UDim2.new(alpha, 0, 1, 0),
            BackgroundColor3 = Theme.Text,
            BorderSizePixel = 0,
        }, bar)
        corner(fill, 4)
        local knob = make("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(alpha, 0, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            BackgroundColor3 = Theme.Text,
            BorderSizePixel = 0,
            ZIndex = 3,
        }, bar)
        corner(knob, 8)

        local current = default
        local dragging = false
        local lockedScroll = {}
        local function setScrollLock(lock)
            if lock then
                local node = hit.Parent
                while node do
                    if node:IsA("ScrollingFrame") then
                        table.insert(lockedScroll, node)
                        node.ScrollingEnabled = false
                    end
                    node = node.Parent
                end
            else
                for _, sf in ipairs(lockedScroll) do
                    pcall(function() sf.ScrollingEnabled = true end)
                end
                table.clear(lockedScroll)
            end
        end
        local function setValue(newValue)
            newValue = math.clamp(math.floor(newValue + 0.5), minValue, maxValue)
            current = newValue
            local a = (newValue - minValue) / (maxValue - minValue)
            fill.Size = UDim2.new(a, 0, 1, 0)
            knob.Position = UDim2.new(a, 0, 0.5, 0)
            valueLabel.Text = tostring(newValue)
            fireCallback(label, newValue)
            if onChange then onChange(newValue) end
        end
        local function setFromX(x)
            local width = math.max(hit.AbsoluteSize.X, 1)
            local a = math.clamp((x - hit.AbsolutePosition.X) / width, 0, 1)
            setValue(minValue + (maxValue - minValue) * a)
        end

        local pending, pendingInput, pendingStart = false, nil, nil
        track(hit.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                setScrollLock(true)
                setFromX(input.Position.X)
            elseif input.UserInputType == Enum.UserInputType.Touch then
                pending = true
                pendingInput = input
                pendingStart = Vector2.new(input.Position.X, input.Position.Y)
            end
        end))
        track(UserInputService.InputChanged:Connect(function(input)
            if dragging then
                if input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch then
                    setFromX(input.Position.X)
                end
            elseif pending and input.UserInputType == Enum.UserInputType.Touch and input == pendingInput then
                local dx = math.abs(input.Position.X - pendingStart.X)
                local dy = math.abs(input.Position.Y - pendingStart.Y)
                if dx >= 6 and dx > dy * 1.2 then
                    pending = false
                    dragging = true
                    setScrollLock(true)
                    setFromX(input.Position.X)
                elseif dy >= 6 then
                    pending = false
                end
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
                pending = false
                setScrollLock(false)
            end
        end))
        record.SearchText ..= " " .. string.lower(label)
        table.insert(controls, {
            Key = title .. "/" .. label,
            Default = default,
            Get = function() return current end,
            Set = setValue,
        })
    end

    track(frame.MouseEnter:Connect(function()
        tween(frame, 0.15, { BackgroundColor3 = Theme.Panel2 })
        tween(frame:FindFirstChildWhichIsA("UIStroke"), 0.15, { Color = Theme.StrokeLight, Transparency = 0.2 })
    end))
    track(frame.MouseLeave:Connect(function()
        tween(frame, 0.15, { BackgroundColor3 = Theme.Panel })
        tween(frame:FindFirstChildWhichIsA("UIStroke"), 0.15, { Color = Theme.Stroke, Transparency = 0.35 })
    end))

    return card
end

