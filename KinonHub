local currentPage = Pages[1]
local searchText = ""
local records = {}

local function matches(record)
    local pageOK
    if currentPage.Key == "DASH" then
        pageOK = record.Category == "DASH"
    elseif currentPage.Key == "ALL" then
        pageOK = record.Category ~= "UI" and record.Category ~= "DASH"
    elseif currentPage.Key == "UI" then
        pageOK = record.Category == "UI"
    else
        pageOK = record.Category == currentPage.Key or record.Category == "BOTH"
    end
    local queryOK = searchText == "" or string.find(record.SearchText, searchText, 1, true) ~= nil
    return pageOK and queryOK
end

local function relayoutColumns()
    local visible = {}
    for _, record in ipairs(records) do
        if matches(record) then
            table.insert(visible, record)
        else
            record.Frame.Parent = nil
        end
    end

    -- urutan mengikuti Order (kalau ada) lalu urutan pembuatan, jadi susunan kartu tetap rapi
    table.sort(visible, function(a, b)
        local ao, bo = a.Order or (1000 + a.Index), b.Order or (1000 + b.Index)
        if ao ~= bo then return ao < bo end
        return a.Index < b.Index
    end)

    local single = #visible == 1
    local reserve = 42
    LeftColumn.Size = single and UDim2.new(1, 0, 1, -reserve) or UDim2.new(0.5, -4, 1, -reserve)
    RightColumn.Size = UDim2.new(0.5, -4, 1, -reserve)
    RightColumn.Visible = not single and #visible > 0
    LeftColumn.Visible = #visible > 0

    local leftHeight, rightHeight = 0, 0
    for order, record in ipairs(visible) do
        record.Frame.LayoutOrder = order
        if single or leftHeight <= rightHeight then
            record.Frame.Parent = LeftColumn
            leftHeight += record.Height + 8
        else
            record.Frame.Parent = RightColumn
            rightHeight += record.Height + 8
        end
    end

    EmptyLabel.Visible = #visible == 0
    CountLabel.Text = #visible == 1 and "1 FEATURE" or (#visible .. " FEATURES")
end

local function relayout(keepScroll)
    relayoutColumns()
    if not keepScroll then
        LeftColumn.CanvasPosition = Vector2.zero
        RightColumn.CanvasPosition = Vector2.zero
    end
end

local scrollMem = {}
local TAB_IDLE = 0.5
local TAB_ACTIVE = 0.15
local pageButtons = {}
local function selectPage(page)
    if currentPage and currentPage ~= page then
        scrollMem[currentPage.Key] = { LeftColumn.CanvasPosition.Y, RightColumn.CanvasPosition.Y }
    end
    local keep = scrollMem[page.Key] or { LeftColumn.CanvasPosition.Y, RightColumn.CanvasPosition.Y }
    LeftColumn.CanvasPosition = Vector2.new(0, keep[1])
    RightColumn.CanvasPosition = Vector2.new(0, keep[2])
    currentPage = page
    PageTitle.Text = page.Title
    PageSub.Text = page.Sub
    for _, entry in ipairs(pageButtons) do
        local active = entry.Page == page
        tween(entry.Button, 0.12, { BackgroundTransparency = active and TAB_ACTIVE or TAB_IDLE })
        tween(entry.Glyph, 0.12, { ImageColor3 = active and Theme.Text or Theme.Muted })
        if entry.Stroke then
            tween(entry.Stroke, 0.12, { Transparency = active and 0.35 or 1 })
        end
        if entry.Label then
            tween(entry.Label, 0.12, { TextColor3 = active and Theme.Text or Theme.Muted })
        end
    end
    relayout(true)
    LeftColumn.CanvasPosition = Vector2.new(0, keep[1])
    RightColumn.CanvasPosition = Vector2.new(0, keep[2])
    task.spawn(function()
        RunService.RenderStepped:Wait()
        RunService.RenderStepped:Wait()
        if currentPage ~= page then return end
        LeftColumn.CanvasPosition = Vector2.new(0, keep[1])
        RightColumn.CanvasPosition = Vector2.new(0, keep[2])
    end)
end

local function registerPage(page, button, glyph, label, buttonStroke)
    table.insert(pageButtons, { Page = page, Button = button, Glyph = glyph, Label = label, Stroke = buttonStroke })
    track(button.MouseButton1Click:Connect(function()
        selectPage(page)
    end))
    track(button.MouseEnter:Connect(function()
        if currentPage ~= page then
            tween(button, 0.1, { BackgroundTransparency = 0.32 })
        end
    end))
    track(button.MouseLeave:Connect(function()
        if currentPage ~= page then
            tween(button, 0.1, { BackgroundTransparency = TAB_IDLE })
        end
    end))
end

