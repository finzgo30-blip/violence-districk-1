State.SpearAimlock = (function()
	local UIS = game:GetService("UserInputService")
	local CFG = { SPAWN_OFFSET = 3, MAX_DIST = 2000, HYSTERESIS = 0.75 }
	local S = { Enabled = false, FOV = 120, Speed = 165, Gravity = 98.1, MaxLife = 4, TargetChar = nil, FovAim = true, Highlight = true, Smooth = false, SmoothAmt = 35 }
	local St = {
		charging = false, attacking = false, locked = nil,
		button = nil, conns = {}, uisConns = {},
		render = nil, thread = nil, accum = 0,
	}

	local function ballisticCheck(origin, target, speed, gravity, maxLife)
		local delta = target - origin
		local d = Vector3.new(delta.X, 0, delta.Z).Magnitude
		local y = delta.Y
		if d < 0.1 then return math.abs(y) / speed <= maxLife end
		local v2 = speed * speed
		local disc = v2 * v2 - gravity * (gravity * d * d + 2 * y * v2)
		if disc < 0 then return false end
		local tanTheta = (v2 - math.sqrt(disc)) / (gravity * d)
		local cosT = math.cos(math.atan(tanTheta))
		if cosT <= 0.001 then return false end
		local t = d / (speed * cosT)
		return t >= 0 and t <= maxLife
	end

	local function computeAim(origin, target, speed, gravity, maxLife)
		local dir = (target - origin).Unit
		for _ = 1, 3 do
			local ao = origin + dir * CFG.SPAWN_OFFSET
			local delta = target - ao
			local horiz = Vector3.new(delta.X, 0, delta.Z)
			local d = horiz.Magnitude
			local y = delta.Y
			if d < 0.1 then return (target - origin).Unit, true end
			local v2 = speed * speed
			local disc = v2 * v2 - gravity * (gravity * d * d + 2 * y * v2)
			if disc < 0 then return (target - origin).Unit, false end
			local theta = math.atan((v2 - math.sqrt(disc)) / (gravity * d))
			dir = (horiz.Unit * math.cos(theta)) + Vector3.new(0, math.sin(theta), 0)
		end
		local fo = origin + dir * CFG.SPAWN_OFFSET
		return dir, ballisticCheck(fo, target, speed, gravity, maxLife)
	end

	local function isReachable(origin, target)
		local dir = (target - origin).Unit
		local ao = origin + dir * CFG.SPAWN_OFFSET
		if ballisticCheck(ao, target, S.Speed, S.Gravity, S.MaxLife) then return true end
		local _, ok = computeAim(origin, target, S.Speed, S.Gravity, S.MaxLife)
		return ok
	end

	local function getFovRadius()
		local cam = workspace.CurrentCamera
		if not cam then return 0 end
		local vp = cam.ViewportSize
		local camFov = math.rad(cam.FieldOfView)
		local half = math.rad(math.min(S.FOV, 359) * 0.5)
		return math.min((vp.Y / 2) * (math.tan(half) / math.tan(camFov / 2)), vp.Y * 0.95)
	end

	local function isEnemy(plr)
		if plr == LP then return false end
		local a, b = LP.Team, plr.Team
		if not a or not b then return false end
		return a ~= b
	end

	local function isValidTarget(char, hum)
		if not hum or hum.Health <= 20 then return false end
		if char:GetAttribute("Knocked") or char:GetAttribute("IsKnocked") then return false end
		if char:GetAttribute("IsHooked") then return false end
		local hp = char:GetAttribute("HookPhase") or char:GetAttribute("HookedPhase")
		if type(hp) == "number" and hp > 0 then return false end
		return true
	end

	local function getAttackButton()
		local pg = LP:FindFirstChild("PlayerGui")
		local mob = pg and pg:FindFirstChild("Slasher-mob")
		local ctrl = mob and mob:FindFirstChild("Controls")
		local btn = ctrl and (ctrl:FindFirstChild("attack") or ctrl:FindFirstChild("Attack"))
		if btn and btn:IsA("GuiObject") then return btn end
		return nil
	end

	local function unbindButton()
		for _, c in ipairs(St.conns) do pcall(function() c:Disconnect() end) end
		St.conns = {}
		St.button = nil
	end

	local function startAttack()
		St.attacking = true
		St.locked = nil
		S.TargetChar = nil
		St.accum = 1
	end

	local function isAttackInput(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	local function bindButton()
		local btn = getAttackButton()
		if not btn then
			if St.button then unbindButton() end
			return
		end
		if btn == St.button then return end
		unbindButton()
		St.button = btn
		table.insert(St.conns, btn.InputBegan:Connect(function(input)
			if isAttackInput(input) then startAttack() end
		end))
		table.insert(St.conns, btn.InputEnded:Connect(function(input)
			if isAttackInput(input) then St.attacking = false end
		end))
	end

	local function updateTarget(dt)
		local cam = workspace.CurrentCamera
		if not cam then return end
		St.accum = St.accum + dt
		if St.accum < 0.05 then return end
		St.accum = 0

		local vp = cam.ViewportSize
		local center = Vector2.new(vp.X / 2, vp.Y / 2)
		local r = getFovRadius()
		local camPos = cam.CFrame.Position

		local currentSd
		if St.locked and St.locked.Character then
			local currHRP = St.locked.Character:FindFirstChild("HumanoidRootPart")
			if currHRP then
				local csp, con = cam:WorldToViewportPoint(currHRP.Position)
				if con then currentSd = (Vector2.new(csp.X, csp.Y) - center).Magnitude end
			end
		end

		local best, bestD = nil, math.huge
		for _, plr in ipairs(Players:GetPlayers()) do
			if isEnemy(plr) then
				local ch = plr.Character
				local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
				local hum = ch and ch:FindFirstChildOfClass("Humanoid")
				if hrp and hum and isValidTarget(ch, hum) and (hrp.Position - camPos).Magnitude <= CFG.MAX_DIST then
					if isReachable(camPos, hrp.Position) then
						local sp, on = cam:WorldToViewportPoint(hrp.Position)
						local sd
						if on then
							sd = (Vector2.new(sp.X, sp.Y) - center).Magnitude
							if S.FovAim and sd > r then sd = nil end
						elseif not S.FovAim then
							sd = 5000 + (hrp.Position - camPos).Magnitude
						end
						if sd and sd < bestD then best, bestD = plr, sd end
					end
				end
			end
		end

		if currentSd and bestD and St.locked and St.locked ~= best and bestD > currentSd * CFG.HYSTERESIS then
			best = St.locked
		end
		St.locked = best
		S.TargetChar = best and best.Character or nil
	end

	local function onRender(dt)
		if unloaded or not S.Enabled then return end
		if not (St.charging and St.attacking) then
			if St.locked then St.locked = nil; S.TargetChar = nil end
			pcall(State.ClearMark, "aimspear")
			return
		end
		updateTarget(dt)
		if not St.locked then return end
		local cam = workspace.CurrentCamera
		local tc = St.locked.Character
		local tp = tc and tc:FindFirstChild("HumanoidRootPart")
		if not (cam and tp) then St.locked = nil; S.TargetChar = nil; return end
		local origin = cam.CFrame.Position
		local dir, reachable = computeAim(origin, tp.Position, S.Speed, S.Gravity, S.MaxLife)
		if reachable then
			local goal = CFrame.lookAt(origin, origin + dir)
			if S.Smooth then
				local a = 1 - (1 - math.clamp((tonumber(S.SmoothAmt) or 35) / 100, 0.02, 1)) ^ (math.clamp(dt, 0.001, 0.1) * 60)
				cam.CFrame = cam.CFrame:Lerp(goal, a)
			else
				cam.CFrame = goal
			end
			if S.Highlight and tc then
				pcall(State.SetMark, "aimspear", tc, Color3.fromRGB(255, 60, 80))
			else
				pcall(State.ClearMark, "aimspear")
			end
		else
			pcall(State.ClearMark, "aimspear")
			St.locked = nil
			S.TargetChar = nil
		end
	end

	local function stop()
		if St.render then St.render:Disconnect(); St.render = nil end
		if St.thread then pcall(task.cancel, St.thread); St.thread = nil end
		for _, c in ipairs(St.uisConns) do pcall(function() c:Disconnect() end) end
		St.uisConns = {}
		unbindButton()
		St.charging, St.attacking, St.locked = false, false, nil
		S.TargetChar = nil
		pcall(State.ClearMark, "aimspear")
	end

	function S.Refresh()
		if S.Enabled and not unloaded then
			if not St.render then St.render = RunService.RenderStepped:Connect(onRender) end
			if #St.uisConns == 0 then
				table.insert(St.uisConns, UIS.InputBegan:Connect(function(input, processed)
					if input.UserInputType == Enum.UserInputType.MouseButton1 and not processed then startAttack() end
				end))
				table.insert(St.uisConns, UIS.InputEnded:Connect(function(input)
					if input.UserInputType == Enum.UserInputType.MouseButton1 then St.attacking = false end
				end))
			end
			if not St.thread then
				St.thread = task.spawn(function()
					while S.Enabled and not unloaded do
						task.wait(0.1)
						local c = LP.Character
						if c then
							local equipped = LP:GetAttribute("EquippedItem")
							local hasSpear = c:FindFirstChild("Spear") ~= nil or equipped == "Veil Spear" or equipped == "Spear"
							St.charging = hasSpear and c:GetAttribute("spearmode") == true
						else
							St.charging, St.attacking = false, false
						end
						bindButton()
					end
					St.thread = nil
				end)
			end
		else
			stop()
		end
	end

	function S.Destroy()
		S.Enabled = false
		stop()
	end

	return S
end)()
Hooks.SpearAimlock = function(s)
