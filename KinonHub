	local function addDropdown(card, label, iconName, values, fmt, get, set, buttonWidth)
		local row = card.k:row(ROW_H)
		local w = math.clamp(tonumber(buttonWidth) or 120, 104, 170)
		rowLabel(row, label, w + 10)
		local btn, cur = dropButton(row, w)
		local function render() cur.Text = tostring(fmt(get())) end
		render()
		btn.MouseButton1Click:Connect(function()
			if popBtn == btn then closePopup() return end
			local entries = {}
			for _, v in ipairs(values) do entries[#entries + 1] = v end
			showPopup(btn, entries, fmt, function(v) return get() == v end,
				function(v) set(v); render() end, false, label)
		end)

		local d = get()
		if type(d) == "string" or type(d) == "number" or type(d) == "boolean" then
			reg(card, label, d, function() return get() end, function(v)
				for _, x in ipairs(values) do
					if x == v then set(v); render(); return end
				end
			end)
		end
	end

