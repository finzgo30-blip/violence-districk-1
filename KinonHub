-- =====================================================================
-- ADAPTER: komponen lama (addCard/addCheckbox/addSlider/dll) -> kartu & toggle UI baru
-- =====================================================================
local function KinonBuildFeatures(api)
	local TH = api.Theme
	local ROW_H = 30

	-- Kategori halaman + urutan tampil (kecil = paling atas): Survivor -> Killer -> Visual -> Umum
	local CATEGORY = {
		Parry = "SURV", ParryV2 = "SURV", FakeParry = "SURV", SkillCheck = "SURV",
		TOF = "SURV", TOFSilent = "SURV", AimFlash = "SURV",
		Spear = "KILL", SpearAimlock = "KILL", SilentChain = "KILL",
		ESPPlayer = "VIS", ESPWorld = "VIS", AvatarVisual = "VIS", WorldSettings = "VIS", CameraSettings = "VIS",
		Moonwalk = "BOTH", Utilities = "BOTH", AutoPumpkin = "BOTH",
		UtilitiesS = "SURV", UtilitiesK = "KILL",
	}
	local ORDER = {
		Parry = 1, ParryV2 = 2, FakeParry = 3, SkillCheck = 4, TOF = 5, TOFSilent = 6, AimFlash = 7,
		Spear = 10, SpearAimlock = 11, SilentChain = 12,
		ESPPlayer = 20, ESPWorld = 21, AvatarVisual = 22, WorldSettings = 23, CameraSettings = 24,
		Moonwalk = 30, Utilities = 31, AutoPumpkin = 32,
		UtilitiesS = 8, UtilitiesK = 13,
	}

	local function rowLabel(row, text, reserve)
		return new("TextLabel", {
			Size = UDim2.new(1, -(reserve or 0), 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = text,
			TextColor3 = TH.Label,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, row)
	end

	-- daftarkan kontrol non-toggle/slider (dropdown, warna) ke penyimpanan config UI baru
	local function reg(card, label, default, getter, setter)
		if default == nil then return end
		pcall(api.registerControl, card.title .. "/" .. label, default, getter, setter)
	end

	local function toHex(c)
		return string.format("#%02x%02x%02x",
			math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
	end
	local function fromHex(s)
		local r, g, b = tostring(s):match("^#(%x%x)(%x%x)(%x%x)$")
		if r then return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16)) end
		return nil
	end

	-- ---------------------------------------------------------------- kartu
	local function addCard(order, iconName, title, subtitle, key, onToggle)
		local k = api.createCard(string.upper(title), iconName, CATEGORY[key] or "BOTH", ORDER[key] or (100 + order))
		local s = State[key]
		local card = { k = k, title = string.upper(title), key = key, toggle = {} }

		card.sub = setmetatable({}, {
			__newindex = function() end,
			__index = function() return "" end,
		})

		card.refresh = function() end
		if s then
			local handle = k:toggle("Enabled", s.Enabled == true, function(v)
				if (s.Enabled == true) == v then return end
				s.Enabled = v
				if onToggle then onToggle(v) else fire(key) end
			end)
			card.refresh = function()
				if handle then handle.Refresh(s.Enabled == true) end
			end
		end
		return card
	end

	-- ---------------------------------------------------------------- toggle & slider
	local function addCheckbox(card, label, iconName, get, set, colorGet, colorSet, roleTag)
		local text = label
		if roleTag then text = label .. " (" .. tostring(roleTag) .. ")" end
		local handle = card.k:toggle(text, get() and true or false, function(v) set(v) end)
		if colorGet and colorSet and handle and handle.Row then
			card.addToggleSwatch(card, handle.Row, label .. " Color", colorGet, colorSet)
		end
	end

	local function addSlider(card, label, iconName, min, max, get, set)
		local default = tonumber(get()) or min
		card.k:slider(label, min, max, math.clamp(default, min, max), function(v) set(v) end)
	end

	-- ---------------------------------------------------------------- baris custom (textbox, tombol, status)
	local function addOption(card, label, iconName, wide)
		local row = card.k:row(ROW_H)
		local rowBtn = new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			AutoButtonColor = false,
		}, row)

		if wide then
			-- baris sebagai tombol (mis. "Apply Avatar")
			row.BackgroundColor3 = TH.Panel3
			row.BackgroundTransparency = 0
			corner(row, 8)
			new("UIStroke", { Color = TH.Stroke, Transparency = 0.4, Thickness = 1 }, row)
			new("TextLabel", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				Text = label,
				TextColor3 = TH.Text,
				TextSize = 13,
			}, row)
			local dummy = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 0) }, row)
			return dummy, rowBtn
		end

		rowLabel(row, label, 140)
		local ctrl = new("Frame", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.new(0, 0, 0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
		}, row)
		new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 6),
		}, ctrl)
		return ctrl, rowBtn
	end

	local POP_H = 34
	local popClose, popBtn
	local function closePopup()
		if popClose then
			local c = popClose
			popClose, popBtn = nil, nil
			pcall(c)
		end
	end

	local function finishPopup(btn, popup, gui, mainFrame, scale, h, minW)
		local function place()
			local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
			local w = math.max(as.X, minW * scale)
			popup.Size = UDim2.fromOffset(w / scale, h)
			local y = ap.Y + as.Y + 4
			if y + h * scale > gui.AbsoluteSize.Y then y = ap.Y - h * scale - 4 end
			popup.Position = UDim2.fromOffset(ap.X + as.X - w, y)
		end
		place()

		local conns = {}
		conns[#conns + 1] = RunService.RenderStepped:Connect(function()
			if not btn:IsDescendantOf(gui) or (mainFrame and not mainFrame.Visible) then
				closePopup()
				return
			end
			if mainFrame then
				local mp, ms2 = mainFrame.AbsolutePosition, mainFrame.AbsoluteSize
				local bp, bs = btn.AbsolutePosition, btn.AbsoluteSize
				if bp.Y < mp.Y or bp.Y + bs.Y > mp.Y + ms2.Y then
					closePopup()
					return
				end
			end
			place()
		end)
		conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1
				and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local p = Vector2.new(input.Position.X, input.Position.Y)
			local function inside(f)
				local fp, fs = f.AbsolutePosition, f.AbsoluteSize
				return p.X >= fp.X and p.X <= fp.X + fs.X and p.Y >= fp.Y and p.Y <= fp.Y + fs.Y
			end
			if inside(popup) or inside(btn) then return end
			closePopup()
		end)

		popBtn = btn
		popClose = function()
			for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
			popup:Destroy()
		end
	end

	local function showPopup(btn, entries, labelOf, isOn, onPick, keepOpen, title)
		closePopup()
		local gui = btn:FindFirstAncestorOfClass("ScreenGui")
		if not gui or #entries == 0 then return end
		local mainFrame = gui:FindFirstChild("Main")
		local ms = mainFrame and mainFrame:FindFirstChildOfClass("UIScale")
		local scale = ms and ms.Scale or 1
		local shown = math.min(#entries, 6)
		local HEAD = 28
		local h = HEAD + shown * POP_H + math.max(shown - 1, 0) * 4 + 12

		local popup = new("Frame", {
			Name = "KinonDropdown",
			BackgroundColor3 = TH.Panel,
			BorderSizePixel = 0,
			Active = true,
			ZIndex = 50,
		}, gui)
